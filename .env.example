# ─── Supabase ───────────────────────────────────────────────────────────────
# 1. Acesse https://supabase.com e abra o projeto
# 2. Vá em Settings → API e copie os valores abaixo
# 3. Renomeie este arquivo para .env (ou crie .env.local)
# 4. No Vercel: Settings → Environment Variables → adicione as mesmas variáveis

SUPABASE_URL=https://xxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Necessário apenas para a Edge Function de gestão de usuários (api/admin-users.js)
# Nunca commitar este valor — adicionar apenas no Vercel e no .env local
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Anthropic ───────────────────────────────────────────────────────────────
# Chave da API da Anthropic — usada pelo servidor para gerar IA (nunca exposta ao cliente)
# Local (vercel dev): adicionar aqui; Produção: Vercel Dashboard → Settings → Environment Variables
ANTHROPIC_API_KEY=sk-ant-...

# ─── Meta Ads ────────────────────────────────────────────────────────────────
# Token de acesso do Meta (System User) — usado SÓ no servidor por api/ad-preview.js
# para gerar o preview dos anúncios. Nunca exposto ao cliente; o repo é público,
# então jamais colocar no código. Produção: Vercel → Settings → Environment Variables
# (a variável META_TOKEN já existe lá). META_ACCESS_TOKEN é aceito como fallback.
META_TOKEN=EAAxxxxxxxxxxxxxxxxxx

# ─── ClickUp ─────────────────────────────────────────────────────────────────
# Token pessoal (pk_...) — usado SÓ no servidor por api/clickup.js (onboarding),
# api/clickup-sync.js e api/clickup-webhook.js (Capacidade do Time).
CLICKUP_API_TOKEN=pk_xxxxxxxx_XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Opcionais — os defaults do código já apontam para o workspace da Revenue Lab
# CLICKUP_TEAM_ID=9009170774
# CLICKUP_CLIENTES_SPACE_ID=90090377342
# CLICKUP_TEMPLATE_LIST_ID=t-901312370990

# Spaces ignorados pelo sync de Capacidade do Time (CSV de IDs).
# Default: 90090379335 (space "Templates" — tarefas modelo, não trabalho real).
# CLICKUP_EXCLUDED_SPACE_IDS=90090379335

# Secret devolvido pelo ClickUp ao registrar o webhook (POST /team/{id}/webhook).
# Sem ele api/clickup-webhook.js recusa todos os payloads — é o que impede
# qualquer pessoa na internet de injetar tarefas no dashboard.
CLICKUP_WEBHOOK_SECRET=

# ─── Vercel Cron ─────────────────────────────────────────────────────────────
# Autentica as execuções agendadas (resultados-autofill e clickup-sync).
CRON_SECRET=
